<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Voice -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Background Execution & WakeLocks -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Overlay HUD on top of all apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- App discovery & Hardware Control -->
    <!-- NOTE (1.4.1, C-B17): QUERY_ALL_PACKAGES was dropped. Launcher
         discovery keeps working WITHOUT it via the scoped <queries>
         declaration below (MAIN/LAUNCHER intent only): the service
         queries launchable apps by intent, and only the matched
         app's label/package is ever logged — no installed-app list
         is collected or sent anywhere. MATCH_ALL is kept (not
         MATCH_DEFAULT_ONLY) deliberately: LAUNCHER activities do not
         declare CATEGORY_DEFAULT, so MATCH_DEFAULT_ONLY would return
         nothing and break app launching by name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <application
        android:name=".JarvisApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_jarvis_core"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jarvis_core"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisAutonomous"
        android:usesCleartextTraffic="false">

        <!-- LiteRT-LM GPU backend libraries: marked not required, so the
             app still installs/runs on phones without OpenCL (CPU fallback). -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <!-- Main Command Center UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Also allow setting Jarvis as default Digital Assistant -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Autonomous Accessibility Service (Tap, Scroll, Type, Read Screen, Navigate) -->
        <service
            android:name=".service.JarvisAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Background Voice & Agent Foreground Service -->
        <service
            android:name=".service.JarvisForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Autonomous voice assistant and multi-step accessibility agent" />
        </service>

        <!-- 1.4.5: Kokoro TTS in an ISOLATED process (:tts). A
             native Sherpa/ONNX death during model load / generate
             kills only this process, never the UI process — the
             main-process client (TtsProcessClient) observes the
             binder death and degrades to a visible failure.
             Not exported: only this app binds to it.
             1.4.8: foregroundServiceType="mediaPlayback" so the
             service can promote itself to foreground DURING a
             speak (TTS_FG_STARTED) — a secondary process is the
             first LMK victim on Vivo; foreground oom_adj is the
             strongest survival signal available. The matching
             FOREGROUND_SERVICE_MEDIA_PLAYBACK permission is
             declared above (Android 14 requires it for this
             type). Promotion is speak-scoped only (see
             KokoroTtsService): no permanent second notification. -->
        <service
            android:name=".service.KokoroTtsService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:process=":tts" />

        <!-- Floating Whiteboard over other apps (S4, 1.4.0) -->
        <service
            android:name=".service.JarvisWhiteboardService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating whiteboard over other apps" />
        </service>

        <!-- Notification Reader Service -->
        <service
            android:name=".service.JarvisNotificationService"
            android:exported="true"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Status Bar Quick Settings Tile ("JARVIS AI") -->
        <service
            android:name=".service.JarvisQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_jarvis_core"
            android:label="JARVIS AI"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Incoming-call announcer: speaks caller name/number on RINGING.
             It never answers the call — Android does not allow a normal
             app to inject voice into call audio. -->
        <receiver
            android:name=".service.JarvisCallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telephony.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Auto-Start on Boot Receiver -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 1.4.4: FileProvider ONLY for sharing the bounce report
             file from the notification Share action (external
             files dir, JarvisDiagnostics/). No other files are
             shared; the provider is not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
